# Supabase PostgreSQL
# DATABASE_URL: Transaction pooler (port 6543, prepare: false)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-sin1.pooler.supabase.com:6543/postgres?sslmode=require

# DIRECT_URL: Direct session connection (port 5432) for migrations and CLI
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-sin1.pooler.supabase.com:5432/postgres?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-plus-bytes-of-hex
BETTER_AUTH_URL=http://localhost:3000

# Seeded ADMIN (pnpm db:seed)
ADMIN_EMAIL=admin@sardarsmall.local
ADMIN_PASSWORD=ChangeMe_Admin_2026!
ADMIN_NAME=Administrator

# Seeded staff for structure / inventory e2e
INVENTORY_EMAIL=inventory@sardarsmall.local
INVENTORY_PASSWORD=ChangeMe_Inventory_2026!
INVENTORY_NAME=Inventory Manager
SALES_EMAIL=sales@sardarsmall.local
SALES_PASSWORD=ChangeMe_Sales_2026!
SALES_NAME=Sales

# Playwright / Vitest against a dedicated non-local DB only
# ALLOW_TEST_DB=1

# Optional
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
